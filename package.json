{
  "name": "@opinionated-ts/config",
  "description": "Opinionated, reusable TypeScript development configurations focused on performance, code quality and developer experience.",
  "keywords": [
    "code-quality",
    "commitlint",
    "cspell",
    "developer-tools",
    "formatter",
    "lefthook",
    "linting",
    "opinionated",
    "oxc",
    "oxfmt",
    "oxlint",
    "tooling",
    "typescript",
    "typescript-config"
  ],
  "homepage": "https://github.com/opinionated-ts/config#readme",
  "bugs": {
    "url": "https://github.com/opinionated-ts/config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Opinionated TS",
    "url": "https://github.com/opinionated-ts"
  },
  "contributors": [
    {
      "name": "Daniel A. Hernández Ochoa",
      "url": "https://github.com/DanhezCode"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/config.git"
  },
  "files": [
    "dist",
    "lefthook.yml",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cspell/dict-es-es": "^3.0.8",
    "cspell": "^10.0.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": "^1.4.0",
    "node": "^26.2.0"
  },
  "packageManager": "bun@1.4.0"
}
