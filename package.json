{
  "name": "@opinionated-ts/config",
  "description": "Opinionated, reusable TypeScript development configurations focused on performance, code quality and developer experience.",
  "keywords": [
    "code-quality",
    "commitlint",
    "cspell",
    "developer-tools",
    "formatter",
    "lefthook",
    "linting",
    "opinionated",
    "oxc",
    "oxfmt",
    "oxlint",
    "tooling",
    "typescript",
    "typescript-config"
  ],
  "homepage": "https://github.com/opinionated-ts/config#readme",
  "bugs": {
    "url": "https://github.com/opinionated-ts/config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Opinionated TS",
    "url": "https://github.com/opinionated-ts"
  },
  "contributors": [
    {
      "name": "Daniel A. Hernández Ochoa",
      "url": "https://github.com/DanhezCode"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/config.git"
  },
  "files": [
    "dist",
    "lefthook.yml",
    "tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./lefthook.yml": "./lefthook.yml",
    "./tsconfig.json": "./tsconfig.json",
    "./release": "./dist/configs/semanticReleaseConfig.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install",
    "audit": "bun audit fix --ignore GHSA-vfj7-8cjw-p6xm"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-es-es": "^3.0.9",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "cspell": "^10.3.6",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "semantic-release": "^25.0.9"
  },
  "devDependencies": {
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "skills": "^1.7.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {},
  "overrides": {
    "tinypool": "2.1.2"
  },
  "engines": {
    "bun": "^1.4.0",
    "node": "^26.2.0"
  },
  "packageManager": "bun@1.4.0",
  "inlinedDependencies": {
    "@commitlint/types": "21.2.0"
  }
}
